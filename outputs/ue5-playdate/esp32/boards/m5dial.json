{
  "build": {
    "arduino": {"ldscript": "esp32s3_out.ld"},
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "m5stack_stamp_s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "extra_flags": ["-DARDUINO_M5STACK_STAMP_S3", "-DARDUINO_USB_MODE=1", "-DARDUINO_RUNNING_CORE=1", "-DARDUINO_EVENT_RUNNING_CORE=1"],
    "hwids": [["0x303A", "0x1001"]]
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {"default_tool": "esp-builtin", "onboard_tools": ["esp-builtin"], "openocd_target": "esp32s3.cfg"},
  "frameworks": ["arduino", "espidf"],
  "name": "M5Stack M5Dial (StampS3, 8 MiB flash, no PSRAM)",
  "upload": {"flash_size": "8MB", "maximum_ram_size": 327680, "maximum_size": 8388608, "require_upload_port": true, "speed": 921600},
  "url": "https://docs.m5stack.com/en/core/Dial",
  "vendor": "M5Stack"
}
